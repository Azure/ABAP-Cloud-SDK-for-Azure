INTERFACE zif_az_blob_service PUBLIC.
* Title: Azure Blob Storage
* Version: 2026-06-06

  CONSTANTS base_path TYPE string VALUE 'https://{url}'.

* GeoReplication
* Enum: geo_replication-status
  CONSTANTS: BEGIN OF c_enum_geo_replication_statu,
               live TYPE string VALUE 'live',
               bootstrap TYPE string VALUE 'bootstrap',
               unavailable TYPE string VALUE 'unavailable',
             END OF c_enum_geo_replication_statu.
  TYPES: BEGIN OF geo_replication,
           status TYPE string,
           last_sync_time TYPE string,
         END OF geo_replication.
* StorageServiceStats
  TYPES: BEGIN OF storage_service_stats,
           geo_replication TYPE geo_replication,
         END OF storage_service_stats.
* StaticWebsite
  TYPES: BEGIN OF static_website,
           enabled TYPE abap_bool,
           index_document TYPE string,
           error_document404_path TYPE string,
           default_index_document_path TYPE string,
         END OF static_website.
* RetentionPolicy
  TYPES: BEGIN OF retention_policy,
           enabled TYPE abap_bool,
           days TYPE i,
           allow_permanent_delete TYPE abap_bool,
         END OF retention_policy.
* Metrics
  TYPES metrics TYPE string.
* Logging
  TYPES: BEGIN OF logging,
           version TYPE string,
           delete TYPE abap_bool,
           read TYPE abap_bool,
           write TYPE abap_bool,
           retention_policy TYPE retention_policy,
         END OF logging.
* CorsRule
  TYPES: BEGIN OF cors_rule,
           allowed_origins TYPE string,
           allowed_methods TYPE string,
           allowed_headers TYPE string,
           exposed_headers TYPE string,
           max_age_in_seconds TYPE i,
         END OF cors_rule.
* StorageServiceProperties
  TYPES: BEGIN OF storage_service_properties,
           logging TYPE logging,
           hour_metrics TYPE metrics,
           minute_metrics TYPE metrics,
           cors TYPE STANDARD TABLE OF cors_rule WITH DEFAULT KEY,
           default_service_version TYPE string,
           delete_retention_policy TYPE retention_policy,
           static_website TYPE static_website,
         END OF storage_service_properties.
* AccessPolicy
  TYPES: BEGIN OF access_policy,
           start TYPE timestampl,
           expiry TYPE timestampl,
           permission TYPE string,
         END OF access_policy.
* SignedIdentifier
  TYPES: BEGIN OF signed_identifier,
           id TYPE string,
           access_policy TYPE access_policy,
         END OF signed_identifier.
* SignedIdentifiers
  TYPES signed_identifiers TYPE STANDARD TABLE OF signed_identifier WITH DEFAULT KEY.
* RehydratePriority
  TYPES rehydrate_priority TYPE string.
* QueryType
  TYPES query_type TYPE string.
* ArrowField
  TYPES: BEGIN OF arrow_field,
           type TYPE string,
           name TYPE string,
           precision TYPE i,
           scale TYPE i,
         END OF arrow_field.
* ParquetConfiguration
  TYPES: BEGIN OF parquet_configuration,
           dummy_workaround TYPE i,
         END OF parquet_configuration.
* ArrowConfiguration
  TYPES: BEGIN OF arrow_configuration,
           schema TYPE STANDARD TABLE OF arrow_field WITH DEFAULT KEY,
         END OF arrow_configuration.
* JsonTextConfiguration
  TYPES: BEGIN OF json_text_configuration,
           record_separator TYPE string,
         END OF json_text_configuration.
* DelimitedTextConfiguration
  TYPES: BEGIN OF delimited_text_configuration,
           column_separator TYPE string,
           field_quote TYPE string,
           record_separator TYPE string,
           escape_char TYPE string,
           headers_present TYPE abap_bool,
         END OF delimited_text_configuration.
* QueryFormat
  TYPES: BEGIN OF query_format,
           type TYPE query_type,
           delimited_text_configuration TYPE delimited_text_configuration,
           json_text_configuration TYPE json_text_configuration,
           arrow_configuration TYPE arrow_configuration,
           parquet_text_configuration TYPE parquet_configuration,
         END OF query_format.
* QuerySerialization
  TYPES: BEGIN OF query_serialization,
           format TYPE query_format,
         END OF query_serialization.
* QueryRequest
* Enum: query_request-query_type
  CONSTANTS: BEGIN OF c_enum_query_request_query_t,
               sql TYPE string VALUE 'SQL',
             END OF c_enum_query_request_query_t.
  TYPES: BEGIN OF query_request,
           query_type TYPE string,
           expression TYPE string,
           input_serialization TYPE query_serialization,
           output_serialization TYPE query_serialization,
         END OF query_request.
* ClearRange
  TYPES: BEGIN OF clear_range,
           start TYPE i,
           end TYPE i,
         END OF clear_range.
* PageRange
  TYPES: BEGIN OF page_range,
           start TYPE i,
           end TYPE i,
         END OF page_range.
* PageList
