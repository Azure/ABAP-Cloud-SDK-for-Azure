         END OF block_list.
* BlobName
  TYPES: BEGIN OF blob_name,
           encoded TYPE abap_bool,
           content TYPE string,
         END OF blob_name.
* BlobPrefix
  TYPES: BEGIN OF blob_prefix,
           name TYPE blob_name,
         END OF blob_prefix.
* ArchiveStatus
  TYPES archive_status TYPE string.
* AccessTier
  TYPES access_tier TYPE string.
* CopyStatus
  TYPES copy_status TYPE string.
* BlobPropertiesInternal
* Enum: blob_properties_internal-blob_type
  CONSTANTS: BEGIN OF c_enum_blob_properties_inter,
               blockblob TYPE string VALUE 'BlockBlob',
               pageblob TYPE string VALUE 'PageBlob',
               appendblob TYPE string VALUE 'AppendBlob',
             END OF c_enum_blob_properties_inter.
* Enum: blob_properties_internal-immutability_policy_mode
  CONSTANTS: BEGIN OF c_enum_blob_properties_int01,
               mutable TYPE string VALUE 'Mutable',
               unlocked TYPE string VALUE 'Unlocked',
               locked TYPE string VALUE 'Locked',
             END OF c_enum_blob_properties_int01.
  TYPES: BEGIN OF blob_properties_internal,
           creation__time TYPE string,
           last__modified TYPE string,
           etag TYPE string,
           content__length TYPE i,
           content__type TYPE string,
           content__encoding TYPE string,
           content__language TYPE string,
           content_md5 TYPE string,
           content__disposition TYPE string,
           cache__control TYPE string,
           x_ms_blob_sequence_number TYPE i,
           blob_type TYPE string,
           lease_status TYPE lease_status,
           lease_state TYPE lease_state,
           lease_duration TYPE lease_duration,
           copy_id TYPE string,
           copy_status TYPE copy_status,
           copy_source TYPE string,
           copy_progress TYPE string,
           copy_completion_time TYPE string,
           copy_status_description TYPE string,
           server_encrypted TYPE abap_bool,
           incremental_copy TYPE abap_bool,
           destination_snapshot TYPE string,
           deleted_time TYPE string,
           remaining_retention_days TYPE i,
           access_tier TYPE access_tier,
           access_tier_inferred TYPE abap_bool,
           archive_status TYPE archive_status,
           smart_access_tier TYPE access_tier,
           customer_provided_key_sha256 TYPE string,
           encryption_scope TYPE string,
           access_tier_change_time TYPE string,
           tag_count TYPE i,
           expiry__time TYPE string,
           sealed TYPE abap_bool,
           rehydrate_priority TYPE rehydrate_priority,
           last_access_time TYPE string,
           immutability_policy_until_da TYPE string,
           immutability_policy_mode TYPE string,
           legal_hold TYPE abap_bool,
         END OF blob_properties_internal.
* BlobItemInternal
  TYPES: BEGIN OF blob_item_internal,
           name TYPE blob_name,
           deleted TYPE abap_bool,
           snapshot TYPE string,
