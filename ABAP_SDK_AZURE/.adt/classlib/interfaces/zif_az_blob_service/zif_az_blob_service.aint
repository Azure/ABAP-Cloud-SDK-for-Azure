  "--- ergonomic typed convenience methods ---
"! List the blob containers in the storage account.
  METHODS list_containers
    IMPORTING
      iv_prefix      TYPE string OPTIONAL
      iv_max_results TYPE i      OPTIONAL
      iv_marker      TYPE string OPTIONAL
    RETURNING
      VALUE(ro_result)
      TYPE REF TO zcl_az_list_containers_result
    RAISING
      zcx_azure.

  "! List the blobs inside a container (optionally filtered by prefix /
  "! rolled up by delimiter). Supports paging via marker / next_marker.
  METHODS list_blobs
    IMPORTING
      iv_container   TYPE string
      iv_prefix      TYPE string OPTIONAL
      iv_delimiter   TYPE string OPTIONAL
      iv_max_results TYPE i      OPTIONAL
      iv_marker      TYPE string OPTIONAL
    RETURNING
      VALUE(ro_result) TYPE REF TO zcl_az_list_blobs_result
    RAISING
      zcx_azure.

  "! Download a blob's content (bytes) plus its key metadata.
  METHODS download_blob
    IMPORTING
      iv_container TYPE string
      iv_blob_name TYPE string
    RETURNING
      VALUE(ro_result) TYPE REF TO zcl_az_blob_content
    RAISING
      zcx_azure.

  "! Upload (create/overwrite) a block blob in a single Put Blob request.
  METHODS upload_blob
    IMPORTING
      iv_container    TYPE string
      iv_blob_name    TYPE string
      iv_content      TYPE xstring
      iv_content_type TYPE string DEFAULT 'application/octet-stream'
    RETURNING
      VALUE(ro_result) TYPE REF TO zcl_az_upload_blob_result
    RAISING
      zcx_azure.
ENDINTERFACE.