"! Test double for any credential. Implements zif_az_token_credential, so the
"! service client is auth-agnostic: a single fake substitutes for client-secret,
"! managed-identity, environment or default credentials in client-level tests.
"! (Each REAL credential class is tested separately with its own transport double.)
CLASS zcl_az_token_credential_fake DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.


    INTERFACES zif_az_token_credential.

    METHODS constructor
      IMPORTING
        iv_token TYPE string     DEFAULT 'FAKE.JWT.TOKEN'
        iv_fail  TYPE abap_bool  DEFAULT abap_false.

    "! The scope the client/auth-policy asked for (assert per-service scope).
    METHODS get_scope_seen
      RETURNING VALUE(rv_scope) TYPE string.

    "! How many times a token was requested (assert caching when added later).
    METHODS get_call_count
      RETURNING VALUE(rv_count) TYPE i.

  PRIVATE SECTION.

    DATA mv_token      TYPE string.
    DATA mv_fail       TYPE abap_bool.
    DATA mv_scope_seen TYPE string.
    DATA mv_calls      TYPE i.

ENDCLASS.


CLASS zcl_az_token_credential_fake IMPLEMENTATION.

  METHOD constructor.
    mv_token = iv_token.
    mv_fail  = iv_fail.
  ENDMETHOD.


  METHOD zif_az_token_credential~get_token.

    mv_calls      = mv_calls + 1.
    mv_scope_seen = iv_scope.

    IF mv_fail = abap_true.
      RAISE EXCEPTION TYPE zcx_az_auth_error
        EXPORTING iv_message = |Fake credential configured to fail for scope { iv_scope }|.
    ENDIF.

    ro_token = NEW zcl_az_access_token(
                     iv_token      = mv_token
                     iv_expires_in = 3600 ).

  ENDMETHOD.


  METHOD get_scope_seen.
    rv_scope = mv_scope_seen.
  ENDMETHOD.


  METHOD get_call_count.
    rv_count = mv_calls.
  ENDMETHOD.

ENDCLASS.
