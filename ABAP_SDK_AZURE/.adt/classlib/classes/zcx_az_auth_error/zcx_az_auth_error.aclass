CLASS zcx_az_auth_error DEFINITION
  PUBLIC
  INHERITING FROM zcx_azure
  CREATE PUBLIC.

  PUBLIC SECTION.

    METHODS constructor
      IMPORTING
        !iv_message TYPE string OPTIONAL
        !previous   LIKE previous OPTIONAL.

ENDCLASS.



CLASS ZCX_AZ_AUTH_ERROR IMPLEMENTATION.


  METHOD constructor ##ADT_SUPPRESS_GENERATION.
    CALL METHOD super->constructor
      EXPORTING
        iv_message = iv_message
        previous   = previous.
  ENDMETHOD.
ENDCLASS.