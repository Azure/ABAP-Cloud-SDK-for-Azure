CLASS zcl_az_client_secret_cred DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.

    INTERFACES zif_az_token_credential.

    METHODS constructor
      IMPORTING
        iv_client_id     TYPE string
        iv_client_secret TYPE string
        iv_tenant_id     TYPE string
        io_http_client   TYPE REF TO zif_az_http_client OPTIONAL.


  PRIVATE SECTION.

    DATA mv_client_id TYPE string.
    DATA mv_client_secret TYPE string.
    DATA mv_tenant_id TYPE string.
    DATA mo_http_client TYPE REF TO zif_az_http_client.

ENDCLASS.



CLASS ZCL_AZ_CLIENT_SECRET_CRED IMPLEMENTATION.


METHOD constructor.

  mv_client_id     = iv_client_id.
  mv_client_secret = iv_client_secret.
  mv_tenant_id     = iv_tenant_id.
  mo_http_client   = io_http_client.

ENDMETHOD.


METHOD zif_az_token_credential~get_token.

  DATA: lv_url      TYPE string,
        lv_body     TYPE string,
        lt_headers  TYPE STANDARD TABLE OF string,
        lv_response TYPE string.

  DATA: ls_token TYPE zcl_az_token_response=>ty_response.

  " Guards: required credentials must be present
  IF mv_tenant_id IS INITIAL OR mv_client_id IS INITIAL OR mv_client_secret IS INITIAL.
    RAISE EXCEPTION TYPE zcx_az_auth_error
      EXPORTING
        iv_message = |Cannot authenticate: missing tenant, client id, or client secret.|.
  ENDIF.

  IF iv_scope IS INITIAL.
    RAISE EXCEPTION TYPE zcx_az_auth_error
      EXPORTING
        iv_message = |Cannot authenticate: scope is empty.|.
  ENDIF.

  lv_url =
    |https://login.microsoftonline.com/{ mv_tenant_id }/oauth2/v2.0/token|.

  lv_body =
    |grant_type=client_credentials&client_id={ mv_client_id }| &&
    |&client_secret={ mv_client_secret }&scope={ iv_scope }|.

  APPEND 'Content-Type:application/x-www-form-urlencoded' TO lt_headers.
  APPEND 'User-Agent:SAP-Azure-Cloud-Client/1.0' TO lt_headers.

  " Build the HTTP request for the SDK transport pipeline
  DATA(lo_request) = NEW zcl_az_http_request( ).
  lo_request->mv_method  = 'POST'.
  lo_request->mv_url     = lv_url.
  lo_request->mt_headers = lt_headers.
  lo_request->mv_body    = lv_body.

  DATA lo_http_client TYPE REF TO zif_az_http_client.
  " Transport is injectable so unit tests can substitute a double for the token
  " endpoint; production passes nothing and gets the real zcl_az_http_client.
  lo_http_client = COND #( WHEN mo_http_client IS BOUND
                           THEN mo_http_client
                           ELSE NEW zcl_az_http_client( ) ).

  TRY.
      DATA(lo_response) = lo_http_client->send( lo_request ).

      " Defensive: transport must return a bound response
      IF lo_response IS NOT BOUND.
        RAISE EXCEPTION TYPE zcx_az_auth_error
          EXPORTING
            iv_message = |Token endpoint returned no response.|.
      ENDIF.

      " Token endpoint must answer with a successful status
      IF lo_response->is_success( ) <> abap_true.
        RAISE EXCEPTION TYPE zcx_az_auth_error
          EXPORTING
            iv_message = |Token request failed (HTTP { lo_response->get_status_code( ) }): { lo_response->get_body( ) }|.
      ENDIF.

      lv_response = lo_response->get_body( ).

      " Defensive: transport must return a payload
      IF lv_response IS INITIAL.
        RAISE EXCEPTION TYPE zcx_az_auth_error
          EXPORTING
            iv_message = |Token endpoint returned an empty response.|.
      ENDIF.

      /ui2/cl_json=>deserialize(
        EXPORTING json = lv_response
        CHANGING  data = ls_token ).

      " Defensive: a valid token must be present
      IF ls_token-access_token IS INITIAL.
        RAISE EXCEPTION TYPE zcx_az_auth_error
          EXPORTING
            iv_message = |Authentication failed: no access token returned.|.
      ENDIF.

      ro_token = NEW zcl_az_access_token(
                       iv_token      = ls_token-access_token
                       iv_expires_in = ls_token-expires_in ).

    CATCH zcx_az_auth_error INTO DATA(lx_auth).
      RAISE EXCEPTION lx_auth.

    CATCH cx_root INTO DATA(lx_root).
      RAISE EXCEPTION TYPE zcx_az_auth_error
        EXPORTING
          iv_message = |Unexpected error while acquiring access token. { lx_root->get_text( ) }|
          previous   = lx_root.
  ENDTRY.

ENDMETHOD.

ENDCLASS.