CLASS zcl_az_default_credential DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    INTERFACES zif_az_token_credential.

    TYPES:
      BEGIN OF ty_skipped_provider,
        provider TYPE string,
        reason   TYPE string,
      END OF ty_skipped_provider,
      ty_t_skipped_providers TYPE STANDARD TABLE OF ty_skipped_provider
                                  WITH DEFAULT KEY.

    METHODS constructor
      IMPORTING iv_register_defaults TYPE abap_bool DEFAULT abap_true.
    METHODS add_credential
         IMPORTING  io_credential TYPE REF TO zif_az_token_credential
         RAISING    zcx_az_auth_error.
    "! Returns the list of default providers that failed to initialize.
    "! Empty when every default provider was registered successfully.
    METHODS get_skipped_providers
      RETURNING VALUE(rt_skipped) TYPE ty_t_skipped_providers.


  PRIVATE SECTION.

    DATA mt_credentials       TYPE STANDARD TABLE OF REF TO zif_az_token_credential.
    DATA mt_skipped_providers TYPE ty_t_skipped_providers.

    METHODS log_skipped_provider
      IMPORTING iv_provider TYPE string
                ix_error    TYPE REF TO cx_root.
ENDCLASS.



CLASS ZCL_AZ_DEFAULT_CREDENTIAL IMPLEMENTATION.


METHOD constructor.

  DATA lo_cred TYPE REF TO zif_az_token_credential.

  " Tests can start from an empty chain (iv_register_defaults = abap_false) and
  " add their own credential doubles via add_credential.
  IF iv_register_defaults = abap_false.
    RETURN.
  ENDIF.

  TRY.
      lo_cred = NEW zcl_az_environment_credential( ).
      APPEND lo_cred TO mt_credentials.
    CATCH cx_root INTO DATA(lx_env_error).
      " Environment credential unavailable in this system; keep building the
      " chain with the remaining providers, but record why it was skipped.
      log_skipped_provider( iv_provider = 'EnvironmentCredential'
                            ix_error    = lx_env_error ).
  ENDTRY.

  TRY.
      lo_cred = NEW zcl_az_managed_identity_cred( ).
      APPEND lo_cred TO mt_credentials.
    CATCH cx_root INTO DATA(lx_mi_error).
      " Managed-identity credential unavailable; skip it and record the reason.
      log_skipped_provider( iv_provider = 'ManagedIdentityCredential'
                            ix_error    = lx_mi_error ).
  ENDTRY.

ENDMETHOD.


METHOD zif_az_token_credential~get_token.

  DATA lo_credential TYPE REF TO zif_az_token_credential.
  DATA lo_token      TYPE REF TO zcl_az_access_token.

  " Guard: scope must not be empty
  IF iv_scope IS INITIAL.
    RAISE EXCEPTION TYPE zcx_az_auth_error
      EXPORTING
        iv_message = |Cannot authenticate: scope is empty.|.
  ENDIF.

  " Guard: at least one credential must be registered
  IF mt_credentials IS INITIAL.
    RAISE EXCEPTION TYPE zcx_az_auth_error
      EXPORTING
        iv_message = |No credentials available in the credential chain.|.
  ENDIF.

  LOOP AT mt_credentials INTO lo_credential.

    TRY.
        lo_token = lo_credential->get_token( iv_scope = iv_scope ).

        IF lo_token IS BOUND.
          ro_token = lo_token.
          RETURN.
        ENDIF.

      CATCH zcx_az_auth_error.
        " Try the next credential in the chain
        CONTINUE.

      CATCH cx_root.
        " Unexpected failure from this provider; try the next one
        CONTINUE.
    ENDTRY.

  ENDLOOP.

  " No credential in the chain produced a token
  RAISE EXCEPTION TYPE zcx_az_auth_error
    EXPORTING
      iv_message = |Authentication failed: no credential in the chain returned a token.|.

ENDMETHOD.



METHOD add_credential.

  " Guard: credential must be bound
  IF io_credential IS NOT BOUND.
    RAISE EXCEPTION TYPE zcx_az_auth_error
      EXPORTING
        iv_message = |Cannot add credential: credential is not bound.|.
  ENDIF.

  APPEND io_credential TO mt_credentials.

ENDMETHOD.


METHOD log_skipped_provider.

  " A default credential provider raised during construction and is
  " excluded from the chain, but we capture the reason in mt_skipped_providers so operators can
  " diagnose why a specific provider is missing at runtime via
  " get_skipped_providers( ).
  DATA(lv_reason) = COND string( WHEN ix_error IS BOUND
                                 THEN ix_error->get_text( )
                                 ELSE `unknown error` ).

  APPEND VALUE #( provider = iv_provider
                  reason   = lv_reason ) TO mt_skipped_providers.

ENDMETHOD.


METHOD get_skipped_providers.
  rt_skipped = mt_skipped_providers.
ENDMETHOD.

ENDCLASS.